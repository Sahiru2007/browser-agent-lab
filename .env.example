# Optional; set environment variables in your shell (this file is not auto-loaded).
# Default is an isolated local SQLite database.
# DATABASE_URL=postgresql+psycopg://lab:lab@127.0.0.1:5432/lab
# LAB_FAULT=none

# Optional Browser Use adapter. This file is NOT automatically loaded.
# Export these in your shell; never paste actual keys into source or reports.
# Paid browser-use adapter: Anthropic provider/model must be explicitly configured.
ANTHROPIC_API_KEY=replace-with-your-key-in-the-shell
LAB_AGENT_PROVIDER=anthropic
LAB_AGENT_MODEL=replace-with-an-available-anthropic-model-id
LAB_AGENT_MAX_STEPS=12
LAB_AGENT_TIMEOUT_SECONDS=120
LAB_AGENT_MAX_MODEL_CALLS=4
LAB_AGENT_MAX_TOTAL_TOKENS=200000
LAB_AGENT_MAX_INPUT_TOKENS=40000
LAB_AGENT_MAX_OUTPUT_TOKENS=1024
LAB_AGENT_MAX_COST_USD=1.00
# Supply conservative current pricing ceilings for your chosen model,
# including cache-write premiums/multipliers. These placeholders are not prices.
LAB_AGENT_INPUT_USD_PER_MILLION=replace-with-current-input-price-ceiling
LAB_AGENT_OUTPUT_USD_PER_MILLION=replace-with-current-output-price-ceiling

# Local-only alternative: --adapter ollama needs NONE of the paid variables above.
# Its validated fixed configuration is documented in README.md / docs/OLLAMA.md.
# Do not supply cloud credentials or change OLLAMA_HOST to a remote endpoint.
